# Database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://username:password@host:5432/database_name"

# JWT Secret for authentication (access tokens) - Use a strong random string
JWT_SECRET="your-super-secret-jwt-key-replace-with-random-string"

# JWT Refresh Secret for refresh tokens (REQUIRED - must be different from JWT_SECRET)
# Use a different strong random string than JWT_SECRET
JWT_REFRESH_SECRET="your-super-secret-refresh-key-replace-with-different-random-string"

# JWT Access Token Lifetime (optional)
# Shorter tokens are more secure but require more frequent refresh
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: "15m", "30m", "1h", "2h"
# Default: "15m" (15 minutes) for better security
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"

# Node environment
NODE_ENV="development"

# Server Port (3000 to avoid macOS AirPlay conflict on port 5000)
PORT=3000

# Cookie SameSite Policy (optional)
# Options: 'strict' | 'lax' | 'none'
# - 'strict': Same-site only (most secure, but may break cross-origin requests)
# - 'lax': Allow cross-origin navigation (default, good balance)
# - 'none': Allow all cross-site requests (requires HTTPS and CSRF protection)
# If not set, auto-detects based on FRONTEND_URL and BACKEND_URL
COOKIE_SAMESITE_POLICY="lax"

# CSRF Protection (optional)
# Enable CSRF protection for 'lax' cookies in production (defense in depth)
# Automatically enabled for 'none' cookies and cross-site deployments
ENABLE_CSRF_PROTECTION="false"

# Frontend and Backend URLs for auto-detection of cross-site deployment (optional)
# Only needed if COOKIE_SAMESITE_POLICY is not explicitly set
# FRONTEND_URL="https://your-frontend-domain.com"
# BACKEND_URL="https://your-backend-domain.com"
